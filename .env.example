# Safe examples only. Never commit actual credentials or secrets.

# Backend
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret-in-Replit-Secrets
PORT=3001
CORS_ORIGIN=https://app.example.com

# Frontend server-side rewrite target
BACKEND_URL=http://localhost:3001

# Environment
NODE_ENV=development